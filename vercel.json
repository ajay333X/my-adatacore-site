{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/profile", "destination": "/workspace#profile", "permanent": false },
    { "source": "/profile.html", "destination": "/workspace#profile", "permanent": false },
    { "source": "/admin.html", "destination": "/admin", "permanent": false },
    { "source": "/universal_engine", "destination": "/voice-engine", "permanent": false },
    { "source": "/universal_engine.html", "destination": "/voice-engine", "permanent": false },
    { "source": "/task_player", "destination": "/workspace", "permanent": false },
    { "source": "/task_player.html", "destination": "/workspace", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin-secure" },
    { "source": "/admin/recordings", "destination": "/recordings-audit" },
    { "source": "/admin/reviews", "destination": "/admin-l2-reviews" },
    { "source": "/voice-engine", "destination": "/voice-engine-secure" },
    { "source": "/review", "destination": "/review-secure" }
  ],
  "headers": [
    {
      "source": "/auth",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), payment=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
